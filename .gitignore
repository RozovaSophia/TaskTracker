### Django ###
*.log
*.pot
*.pyc
__pycache__/
local_settings.py
db.sqlite3
db.sqlite3-journal
media/

# Если собираешь статику (CSS/JS) локально
staticfiles/
static/

### Python ###
# файлы компиляции
*.py[cod]
*.so
.Python

# Распространенные папки с виртуальным окружением
# (для Docker они не нужны, т.к. образ ставит зависимости сам)
env/
venv/
ENV/
env.bak/
venv.bak/
pythonenv*

# pip freeze вывод
*.egg-info/
*.egg
dist/
build/

### Virtual Environment ###
# Папки виртуального окружения (их точно не надо пушить)
venv
env
.env
.venv
ENV

### Django ###
# Локальные настройки, которых нет в репозитории
*.local.py

