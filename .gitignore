.idea/
*.iml
*.iws
out/
.DS_Store

### Visual Studio Code (IDE) ###
.vscode/
*.code-workspace
.history/

### Docker ###
# Не игнорируем сам docker-compose.yml и Dockerfile, но игнорируем временные файлы докера
.dockerignore
docker-compose.override.yml

### Environment variables ###
# САМОЕ ВАЖНОЕ: Файл с секретами НЕ ДОЛЖЕН попасть в git
.env
.env.local
.env.production
.flaskenv

